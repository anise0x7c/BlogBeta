---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
import { getRecentPosts } from "../utils/posts";
import PostCard from "../components/PostCard.astro";
import ThemedButton from "../components/ThemedButton.astro";

const recent = await getRecentPosts(6);
---

<BaseLayout>
  <section class="hero container">
    <p class="eyebrow">Hello there!</p>
    <h1>Welcome to 80ml Spice Jar</h1>
    <p class="lede">
      {SITE.description}
    </p>
    <div class="cta">
      <ThemedButton
        variant="solid"
        size="lg"
        href="/blogs"
      >
        Read the blog
      </ThemedButton>
      <ThemedButton
        variant="outline"
        size="lg"
        href="https://github.com"
      >
        GitHub
      </ThemedButton>
    </div>
  </section>

  {
    recent.length > 0 && (
      <section class="recent container">
        <header class="section-head">
          <h2>Recent posts</h2>
        </header>
        <ul class="card-list">
          {recent.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .container {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .hero {
    padding-top: 5rem;
    padding-bottom: 4rem;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 600;
    color: var(--color-accent);
    margin: 0 0 0.5rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 18ch;
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 1.25rem 0 0;
    max-width: 46ch;
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .recent {
    padding-bottom: 4rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-head h2 {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .section-head a {
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  .card-list > li {
    display: grid;
  }
</style>
