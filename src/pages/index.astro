---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
import { getRecentPosts } from "../utils/posts";
import PostCard from "../components/PostCard.astro";

const recent = await getRecentPosts(3);
---

<BaseLayout>
  <section class="hero container">
    <p class="eyebrow">Hello there</p>
    <h1>Welcom to 80ml Spice Jar</h1>
    <p class="lede">
      {SITE.description}
    </p>
    <div class="cta">
      <a class="btn primary" href="/blogs">Read the blog</a>
      <a class="btn ghost" href="https://github.com">GitHub</a>
    </div>
  </section>

  {
    recent.length > 0 && (
      <section class="recent container">
        <header class="section-head">
          <h2>Recent posts</h2>
          <a href="/blogs">View all &rarr;</a>
        </header>
        <ul class="card-list">
          {recent.map((post, i) => (
            <li>
              <PostCard post={post} featured={i === 0} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .container {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .hero {
    padding-top: 5rem;
    padding-bottom: 4rem;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 600;
    color: var(--color-accent);
    margin: 0 0 0.5rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 18ch;
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 1.25rem 0 0;
    max-width: 46ch;
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      transform 0.15s var(--ease-bounce),
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s var(--ease-bounce);
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn:active {
    transform: translateY(0);
  }

  .btn.primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    box-shadow: var(--shadow-sticky);
  }

  .btn.primary:hover {
    background: var(--color-accent-strong);
    box-shadow: var(--shadow-card);
  }

  .btn.primary:active {
    box-shadow: var(--shadow-press);
  }

  .btn.ghost {
    color: var(--color-text);
    border-color: var(--color-border);
    box-shadow: var(--shadow-flat);
  }

  .btn.ghost:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-border-strong);
  }

  .recent {
    padding-bottom: 4rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-head h2 {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .section-head a {
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
  }
</style>
