---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
import { getRecentPosts } from "../utils/posts";
import PostCard from "../components/PostCard.astro";
import ThemedButton from "../components/ThemedButton.astro";
import { Image } from "astro:assets";

import Background from "../assets/images/chasing-color-hrz.jpg"

const recent = await getRecentPosts(6);
---

<BaseLayout>
  <Image src={Background} alt="" class="bg"/>
  <section class="hero container">
    <div class="hero-inner">
      <p class="eyebrow">Hello there!</p>
      <h1>Welcome to 80ml Spice Jar</h1>
      <p class="lede">
        {SITE.description}, 由于几乎 100% 由 AI 构建 <br />
        谁知道下一秒会不会爆炸呢 😉
      </p>
      <div class="cta">
        <ThemedButton
          variant="solid"
          size="lg"
          href="/blogs"
          class="rounded-lg "
        >
          Read the blog
        </ThemedButton>
        <ThemedButton
          variant="outline"
          size="lg"
          href="https://github.com"
          class="rounded-lg"
        >
          GitHub
        </ThemedButton>
      </div>
    </div>
  </section>

  {
    recent.length > 0 && (
      <section class="recent container">
        <header class="section-head">
          <h2># Recent posts</h2>
        </header>
        <ul class="card-list">
          {recent.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .container {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .bg {
    inset: 0;
    width: 100%;
    height: 50dvh;
    object-fit: cover;
    z-index: -1;
  }

  .hero-inner {
    background-color: transparent;
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    padding: 3rem;
    border-radius: var(--radius-3xl);
    border: solid 1px var(--color-surface-hover);
    box-shadow:
      var(--shadow-float),
      var(--shadow-lqdglass);
    translate: 0 -50px;
  }

  /* Firefox drops backdrop-filter inside view-transition snapshots
     (Bugzilla 1999295), so the glass card loses its blur for the whole
     animation. Astro brackets every client-side navigation with
     <html data-astro-transition="…">: set before startViewTransition
     (baked into the OLD snapshot), carried across the swap
     (non-overridable attr, baked into the NEW snapshot), removed when
     the transition finishes. Firefox applies :active-view-transition
     too late for the old snapshot — which is why leaving / still showed
     the broken glass. Do NOT add a transition on background-color —
     the gradient would be captured mid-way and the bug would resurface. */
  @supports (-moz-appearance: none) {
    html[data-astro-transition] .hero-inner {
      transition: none;
      background-color: var(--color-canvas);
    }
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 600;
    color: var(--color-accent);
    margin: 0rem 0.3rem 0.7rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 0.3rem;
    max-width: 25ch;
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0rem 0.3rem;
    max-width: 45ch;
  }

  .cta {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .recent {
    padding-bottom: 4rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-head h2 {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .section-head a {
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  .card-list > li {
    display: grid;
  }
</style>
