---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_DESCRIPTION } from "../consts";
import { getRecentPosts } from "../utils/posts";
import FormattedDate from "../components/FormattedDate.astro";

const recent = await getRecentPosts(3);
---

<BaseLayout>
  <section class="hero container">
    <p class="eyebrow">Hello there</p>
    <h1>I write things on the internet.</h1>
    <p class="lede">
      {SITE_DESCRIPTION}
    </p>
    <div class="cta">
      <a class="btn primary" href="/blogs">Read the blog</a>
      <a class="btn ghost" href="https://github.com">GitHub</a>
    </div>
  </section>

  {
    recent.length > 0 && (
      <section class="recent container">
        <header class="section-head">
          <h2>Recent posts</h2>
          <a href="/blogs">View all &rarr;</a>
        </header>
        <ul class="card-list">
          {recent.map((post) => (
            <li>
              <a class="card" href={`/blogs/${post.id}`}>
                <div class="card-meta">
                  <FormattedDate date={post.data.pubDate} />
                  {post.data.tags[0] && (
                    <span class="card-tag">#{post.data.tags[0]}</span>
                  )}
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .container {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .hero {
    padding-top: 5rem;
    padding-bottom: 4rem;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
    margin: 0 0 0.75rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 18ch;
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 1.25rem 0 0;
    max-width: 46ch;
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.15rem;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      transform 0.15s ease,
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn.primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .btn.primary:hover {
    background: var(--color-accent-strong);
  }

  .btn.ghost {
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .btn.ghost:hover {
    background: var(--color-surface-hover);
  }

  .recent {
    padding-bottom: 4rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-head h2 {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .section-head a {
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .card {
    display: block;
    padding: 1.25rem 1.4rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.15s ease;
  }

  .card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: var(--color-subtle);
  }

  .card-tag {
    color: var(--color-accent);
  }

  .card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0.4rem 0 0.35rem;
    color: var(--color-text);
  }

  .card p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
</style>
