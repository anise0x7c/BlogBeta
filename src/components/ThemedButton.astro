---
interface Props {
  variant?: "solid" | "outline";
  size?: "sm" | "md" | "lg";
  iconOnly?: boolean;
  href?: string;
  type?: "button" | "submit";
  title?: string;
  ariaLabel?: string;
  class?: string;
}

const {
  variant = "outline",
  size = "md",
  iconOnly = false,
  href,
  type = "button",
  title,
  ariaLabel,
  class: extra = "",
  ...rest
} = Astro.props;

// Base style
const base =
  "inline-flex items-center justify-center cursor-pointer rounded-md lift";

const variants = {
  solid:
    "border border-accent bg-accent text-accent-contrast\
     hover:bg-accent-strong \
     btn-solid",
  outline:
    "border border-border bg-transparent text-muted\
     hover:border-border-strong hover:bg-surface-hover hover:text-text",
};

const sizes = {
  sm: "gap-1.5 px-3 py-1.5 text-xs font-semibold",
  md: "gap-2 px-4 py-2 text-sm font-medium",
  lg: "gap-2 px-5 py-2.5 text-base font-bold",
};
const sizeClass = iconOnly ? "h-9 w-9" : sizes[size];

const classes = [base, variants[variant], sizeClass, extra].join(" ");
---

{
  href ? (
    <a href={href} class={classes} title={title} aria-label={ariaLabel} {...rest}>
      <slot name="icon" />
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} title={title} aria-label={ariaLabel} {...rest}>
      <slot name="icon" />
      <slot />
    </button>
  )
}

<style>
  .btn-solid {
    box-shadow:
      0 0 14px color-mix(in srgb, var(--color-accent) 40%, transparent),
      0 0 32px color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .btn-solid:hover {
    box-shadow:
      0 0 22px color-mix(in srgb, var(--color-accent-strong) 50%, transparent),
      0 0 52px color-mix(in srgb, var(--color-accent-strong) 25%, transparent);
  }
</style>