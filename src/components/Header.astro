---
import { SITE, NAV_LINKS } from "../consts";
import ThemedButton from "./ThemedButton.astro";
import SearchOverlay from "./SearchOverlay.svelte";

import SearchIcon from "../assets/icons/search.svg";

const pathname = Astro.url.pathname;
function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
}
---

<header class="site-header" transition:name="site-header" transition:animate="none">
  <div class="header-inner">
    <a href="/" class="site-logo">{SITE.title}</a>

    <nav class="header-nav">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={["lift", "nav-link", isActive(link.href) && "active"]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="tools">
      <ThemedButton 
        iconOnly
        title="Search"
        ariaLabel="Search"
        aria-haspopup="dialog"
        aria-expanded="false"
        data-search-trigger
        class="rounded-md"
      >
      <SearchIcon slot="icon" />
      </ThemedButton>

      <ThemedButton
        iconOnly
        title="Toggle dark mode"
        ariaLabel="Toggle dark mode"
        data-theme-toggle
        class="rounded-md"
      >
        <svg
          slot="icon"
          class="theme-sun"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          />
        </svg>
        <svg
          slot="icon"
          class="theme-moon"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </ThemedButton>
    </div>
  </div>
</header>

<!-- Search overlay island: bound to [data-search-trigger] above. client:load
     so ⌘K works before any interaction; the island itself renders nothing
     until opened. -->
<SearchOverlay client:load />



<script>
  // Bundled module scripts run only once. With view transitions the toggle
  // button is a fresh DOM node after every navigation, so re-bind on each
  // `astro:page-load` (which also fires on the initial load).
  const setupThemeToggle = () => {
    document
      .querySelector("[data-theme-toggle]")
      ?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", isDark ? "dark" : "light");
        } catch {
          /* storage may be unavailable */
        }
      });
  };
  document.addEventListener("astro:page-load", setupThemeToggle);
</script>



<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: var(--color-canvas);
    box-shadow: var(--shadow-sticky);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.75rem;
    max-width: var(--container-page);
    margin-inline: auto;
    padding: 0.75rem 1.25rem;
  }

  .site-logo {
    font-family: var(--font-display); /* 手写体 */
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1; /* 行高 = 字号，防止撑高 header */
    letter-spacing: -0.06em; /* 轻微收紧字距 */
    color: var(--color-text);
    text-decoration: none; /* 去掉链接下划线 */
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-link {
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    font-size: 0.92rem;
    color: var(--color-muted);
  }

  .nav-link:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
    background-color: var(--color-surface-hover);
  }

  .nav-link.active,
  .nav-link.active:hover {
    color: var(--color-text);
    font-weight: bold;
    text-decoration: underline;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .theme-sun {
    display: none;
  }

  :global(.dark) .theme-sun {
    display: block;
  }

  .theme-moon {
    display: block;
  }

  :global(.dark) .theme-moon {
    display: none;
  }
</style>
