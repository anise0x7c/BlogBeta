---
import { SITE, NAV_LINKS } from "../consts";
import Search from "./Search.svelte";
import ThemeToggle from "./ThemeToggle.svelte";

const pathname = Astro.url.pathname;
function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
}
---

<header class="sticky z-50 w-full bg-canvas border-b border-border shadow-flat">
  <div class="mx-auto flex min-h-15 max-w-page items-center justify-between gap-4 px-5 py-3">
    <a href="/" class="inline-flex items-baseline text-2xl font-bold leading-none tracking-[-0.01em] text-text no-underline">
      <span class="font-display text-[1.6rem] font-bold">{SITE.title}</span>
    </a>

    <nav class="flex items-center gap-1" aria-label="Primary">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={[
              "px-[0.8rem] py-[0.4rem] rounded-md text-[0.92rem] font-medium text-muted no-underline transition-colors duration-200 hover:text-text hover:bg-surface-hover",
              isActive(link.href) && "text-text bg-surface-hover",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <Search client:idle />
      <ThemeToggle client:load />
    </div>
  </div>
</header>
