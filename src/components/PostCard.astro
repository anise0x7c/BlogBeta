---
import type { Post } from "../utils/posts";
import { Image } from "astro:assets";
import { stickerColor } from "../utils/color";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, cover } = post.data;
const tagChips = tags.map((tag) => ({ tag, color: stickerColor(tag) }));
---

<a
  class:list={["card", "lift", { "has-cover": !!cover }]}
  href={`/blogs/${post.id}`}
>
  {cover && (
    <div class="card-bg">
      <Image src={cover} alt="" width={640} height={360} />
    </div>
  )}
  {cover && <div class="card-veil" aria-hidden="true"></div>}
  <div class="card-texts">
    <div class="card-meta">
      <FormattedDate date={pubDate} />
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="card-tags">
      {
        tagChips.map(({ tag, color }) => (
          <span class="chip" style={`--tag-color: ${color}`}>
            #{tag}
          </span>
        ))
      }
    </div>
  </div>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    text-decoration: none;
  }

  .card:hover {
    box-shadow: var(--shadow-float);
    border-color: var(--color-border-strong);
    transform: translateY(-3px) rotate(-1deg) scale(1.06);
  }

  .card:active {
    transform: translateY(0);
  }

  /* Cover as full-card background */
  .card-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .card-bg :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Blur + darken veil over the background image */
  .card-veil {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(0.75rem);
    -webkit-backdrop-filter: blur(0.75rem);
  }

  .card.has-cover .card-texts {
    position: relative;
  }

  .card.has-cover .card-meta {
    color: rgb(255 255 255 / 0.72);
  }

  .card.has-cover h3 {
    color: #fff;
  }

  .card.has-cover p {
    color: rgb(255 255 255 / 0.82);
  }

  .card-texts {
    flex: 1;
    padding: 1.4rem 1.5rem;
  }

  .card-meta {
    font-size: 0.8rem;
    color: var(--color-subtle);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
    margin-left: -0.2rem;
  }

  .card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0.5rem 0 0.4rem;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .card p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }
</style>
