---
import type { Post } from "../utils/posts";
import { stickerColor } from "../utils/color";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const firstTag = tags[0];
const tagColor = firstTag ? stickerColor(firstTag) : undefined;
---

<a
  class="card"
  href={`/blogs/${post.id}`}
  style={tagColor ? `--tag-color: ${tagColor}` : undefined}
>
  <div class="card-meta">
    <FormattedDate date={pubDate} />
    {
      firstTag && (
        <span class="chip">
          <span class="dot" />
          #{firstTag}
        </span>
      )
    }
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</a>

<style>
  .card {
    position: relative;
    display: block;
    height: 100%;
    padding: 1.4rem 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    transition:
      transform 0.2s var(--ease-bounce),
      box-shadow 0.2s var(--ease-bounce),
      border-color 0.2s var(--ease-bounce);
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-float);
    border-color: var(--color-border-strong);
  }

  .card:active {
    transform: translateY(-1px);
    box-shadow: var(--shadow-press);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: var(--color-subtle);
  }

  .card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0.5rem 0 0.4rem;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .card p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--tag-color, var(--color-accent));
  }
</style>
