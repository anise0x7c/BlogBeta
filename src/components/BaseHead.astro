---
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonical} />
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />

<meta name="twitter:card" content="summary_large_image" />

<!-- Web fonts: Nunito (rounded sans body), Caveat + Ma Shan Zheng (handwritten
     accents). Preconnect first, then the combined stylesheet. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Ma+Shan+Zheng&family=Nunito:wght@400;600;700;800&display=swap"
/>

<!-- Theme is applied before first paint to avoid a flash of the wrong mode.
     Runs inline, synchronously, in <head>. -->
<script is:inline>
  (() => {
    const key = "theme";
    let theme;
    try {
      theme = localStorage.getItem(key);
    } catch {
      theme = null;
    }
    const prefersDark = window.matchMedia(
      "(prefers-color-scheme: dark)",
    ).matches;
    if (theme === "dark" || (!theme && prefersDark)) {
      document.documentElement.classList.add("dark");
    }
  })();
</script>
